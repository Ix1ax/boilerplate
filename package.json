{
  "name": "hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @starter/web",
    "build": "npm run build -w @starter/web",
    "lint": "eslint apps/web packages --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "@eslint/eslintrc": "3.3.7",
    "prettier": "3.9.9",
    "vitest": "5.0.0-rc.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.29",
    "tw-animate-css": "1.4.0"
  },
  "description": "Стартовая монорепа для хакатонов: Next.js, Go и общая инфраструктура",
  "overrides": {
    "postcss": "8.5.29"
  }
}
