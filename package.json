{
  "name": "hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @starter/web",
    "build": "npm run build -w @starter/web",
    "lint": "npm run lint -w @starter/web && eslint packages --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.0.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.10.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "5.0.0-rc.2"
  },
  "description": "Стартовая монорепа для хакатонов: Vite, React, Go и общая инфраструктура",
  "overrides": {
    "postcss": "8.5.29"
  }
}
