{
  "name": "hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "admin",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "build": "npm run build:client && npm run build:admin",
    "lint": "npm run lint -w @starter/client && npm run lint -w @starter/admin && eslint packages --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:case": "node scripts/case-smoke.mjs",
    "dev:client": "npm run dev -w @starter/client",
    "dev:admin": "npm run dev -w @starter/admin",
    "build:client": "npm run build -w @starter/client",
    "build:admin": "npm run build -w @starter/admin"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.0.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.10.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "5.0.0-rc.2",
    "yaml": "^2.6.1"
  },
  "description": "\u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u043c\u043e\u043d\u043e\u0440\u0435\u043f\u0430 \u0434\u043b\u044f \u0445\u0430\u043a\u0430\u0442\u043e\u043d\u043e\u0432: Vite, React, Go \u0438 \u043e\u0431\u0449\u0430\u044f \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430",
  "overrides": {
    "postcss": "8.5.29"
  }
}
