# Используется серверным Compose; Caddy сам получает и продлевает сертификаты.
{$APP_DOMAIN} {
  encode zstd gzip
  # Тестовая почта для жюри: пароль проверяет сам Mailpit (MAILPIT_USER / MAILPIT_PASSWORD).
  redir /mail /mail/
  handle /mail/* {
    reverse_proxy mailpit:8025
  }
  handle {
    reverse_proxy web-service:8080
  }
}
{$AUTH_DOMAIN} {
  reverse_proxy keycloak:8080
}
