COMPOSE_PROJECT_NAME=hackathon-starter
APP_ENV=development
HTTP_ADDR=:18080
APP_ORIGIN=http://localhost:13000
SESSION_COOKIE_SECURE=false
POSTGRES_USER=starter
POSTGRES_DB=starter
POSTGRES_PASSWORD=
DATABASE_URL=postgres://starter:REPLACE_WITH_POSTGRES_PASSWORD@localhost:15432/starter?sslmode=disable
REDIS_ADDR=localhost:16379
REDIS_PASSWORD=
S3_ENDPOINT=http://localhost:18333
S3_REGION=us-east-1
S3_ACCESS_KEY=starter
S3_SECRET_KEY=
S3_BUCKET=starter
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
OIDC_ISSUER=http://localhost:18180/realms/hackathon
OIDC_CLIENT_ID=hackathon-api
OIDC_WEB_CLIENT_ID=hackathon-web
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=
SECOND_DEMO_EMAIL=second@example.test
SECOND_DEMO_PASSWORD=
