# =============================================================================
#  Настройки окружения (шаблон)
# =============================================================================
# Этот файл — образец, он лежит в git. Настоящие значения хранятся в .env
# (он в .gitignore, в git не попадает).
#
# Как пользоваться:
#   1. Ничего не копируйте вручную: выполните `make setup` (или сразу `make demo`).
#      Скрипт создаст .env из этого файла, сгенерирует все пустые пароли и токены
#      и подставит их в строки подключения (REPLACE_WITH_...).
#   2. Повторный `make setup` безопасен: существующие пароли не меняются,
#      новые переменные из шаблона дописываются в конец .env.
#   3. Пустое значение у пароля/токена = «сгенерируй автоматически».
#      Не вписывайте сюда настоящие пароли — этот файл видят все.
#
# Большинство адресов вида localhost:... нужны только при запуске сервисов
# вне Docker (make gateway, make tasks и т.д.). Внутри Docker compose.yaml
# подставляет свои внутренние адреса (tasks-service:8080 и т.п.).
# =============================================================================


# -----------------------------------------------------------------------------
#  Общее
# -----------------------------------------------------------------------------

# Префикс имён томов и сети Docker. Меняйте, если на одной машине нужны
# две копии проекта одновременно (тогда поменяйте и порты ниже).
COMPOSE_PROJECT_NAME=hackathon-starter

# Режим работы: development | production | test.
# production включает строгие проверки (HTTPS, защищённые cookie, токен метрик).
APP_ENV=development

# Для автодеплоя: разные публичные DNS-имена без https:// и путей.
# scripts/setup.mjs --production настроит по ним APP_ORIGIN и OIDC_ISSUER.
APP_DOMAIN=
AUTH_DOMAIN=

# На каком адресе слушает gateway при запуске вне Docker (make gateway).
HTTP_ADDR=:8080

# Адрес, с которого пользователь открывает приложение в браузере.
# По нему Keycloak возвращает после входа, а gateway проверяет Origin запросов.
# На сервере укажите https://ваш-домен.
APP_ORIGIN=http://localhost:3000

# true — cookie сессии только по HTTPS. Локально false, на сервере обязательно true.
SESSION_COOKIE_SECURE=false


# -----------------------------------------------------------------------------
#  Базы данных PostgreSQL — у каждого сервиса своя
# -----------------------------------------------------------------------------
# Для каждого сервиса: пользователь, имя базы, пароль (сгенерируется)
# и порт на вашем компьютере (чтобы подключиться DBeaver/psql или запустить
# сервис вне Docker). Если порт занят — поменяйте только число в *_DB_PORT
# и в соответствующей *_DATABASE_URL ниже.

# Задачи (сервис tasks)
TASKS_DB_USER=tasks
TASKS_DB_NAME=tasks
TASKS_DB_PASSWORD=
TASKS_DB_PORT=5433

# Файлы и вложения (сервис files)
FILES_DB_USER=files
FILES_DB_NAME=files
FILES_DB_PASSWORD=
FILES_DB_PORT=5434

# Уведомления (сервис notifications)
NOTIFICATIONS_DB_USER=notifications
NOTIFICATIONS_DB_NAME=notifications
NOTIFICATIONS_DB_PASSWORD=
NOTIFICATIONS_DB_PORT=5435

# Журнал действий (сервис audit)
AUDIT_DB_USER=audit
AUDIT_DB_NAME=audit
AUDIT_DB_PASSWORD=
AUDIT_DB_PORT=5436

# Мероприятия, организации, записи и обсуждение (сервис events)
EVENTS_DB_USER=events
EVENTS_DB_NAME=events
EVENTS_DB_PASSWORD=
EVENTS_DB_PORT=5437

# База Keycloak (пользователи и вход). Наружу не публикуется, порта нет.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=

# Готовые строки подключения для запуска сервисов вне Docker и для
# интеграционных тестов (make integration). Пароль подставит make setup.
TASKS_DATABASE_URL=postgres://tasks:REPLACE_WITH_TASKS_DB_PASSWORD@localhost:5433/tasks?sslmode=disable
FILES_DATABASE_URL=postgres://files:REPLACE_WITH_FILES_DB_PASSWORD@localhost:5434/files?sslmode=disable
AUDIT_DATABASE_URL=postgres://audit:REPLACE_WITH_AUDIT_DB_PASSWORD@localhost:5436/audit?sslmode=disable
EVENTS_DATABASE_URL=postgres://events:REPLACE_WITH_EVENTS_DB_PASSWORD@localhost:5437/events?sslmode=disable
NOTIFICATIONS_DATABASE_URL=postgres://notifications:REPLACE_WITH_NOTIFICATIONS_DB_PASSWORD@localhost:5435/notifications?sslmode=disable


# -----------------------------------------------------------------------------
#  RabbitMQ — шина событий между сервисами
# -----------------------------------------------------------------------------
# Через неё сервисы сообщают друг другу о событиях (задача создана → ИИ-проверка
# → уведомление), а WebSocket доставляет сообщения на все реплики.
# Веб-консоль: http://localhost:15672 (логин RABBITMQ_USER, пароль из .env).

RABBITMQ_USER=starter
RABBITMQ_PASSWORD=
# Порт брокера и порт веб-консоли на вашем компьютере.
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
# Адрес брокера для сервисов, запущенных вне Docker. Пароль подставит make setup.
AMQP_URL=amqp://starter:REPLACE_WITH_RABBITMQ_PASSWORD@localhost:5672/


# -----------------------------------------------------------------------------
#  Redis — сессии пользователей и лимиты запросов (только gateway)
# -----------------------------------------------------------------------------
# Если Redis перезапустить, все пользователи выйдут из системы — это нормально.

# Адрес для gateway, запущенного вне Docker.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
#  S3 — хранилище загруженных файлов (SeaweedFS, совместим с Amazon S3)
# -----------------------------------------------------------------------------

# Адрес хранилища для сервиса files, запущенного вне Docker.
S3_ENDPOINT=http://localhost:8333
# Регион — формальность для S3-клиента, локально не важен.
S3_REGION=us-east-1
# Логин и секрет хранилища (секрет сгенерируется).
S3_ACCESS_KEY=starter
S3_SECRET_KEY=
# Имя «папки» (бакета), куда складываются файлы.
S3_BUCKET=starter


# -----------------------------------------------------------------------------
#  Keycloak — вход, регистрация и роли пользователей
# -----------------------------------------------------------------------------
# Админка Keycloak: http://localhost:8180 (логин KEYCLOAK_ADMIN, пароль из .env).
# Там можно смотреть пользователей, выдавать роли (user, admin) и настраивать вход.

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Публичный адрес «realm» (пространства пользователей) Keycloak — так его видит
# браузер. Должен совпадать с тем, что записано в токенах, иначе вход не пройдёт.
# На сервере: https://ваш-домен-keycloak/realms/hackathon
OIDC_ISSUER=http://localhost:8180/realms/hackathon
# Идентификаторы приложений в Keycloak: api — для проверки токенов в Go,
# web — для входа через браузер. Менять не нужно.
OIDC_CLIENT_ID=hackathon-api
OIDC_WEB_CLIENT_ID=hackathon-web


# -----------------------------------------------------------------------------
#  Демо-пользователи — создаются автоматически для показа и тестов
# -----------------------------------------------------------------------------
# make setup записывает их в Keycloak, make demo печатает логины и пароли.
# Почты можно поменять на свои (до первого запуска Keycloak или после make reset).

# Обычный пользователь (роль user)
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=
# Второй пользователь — для проверки, что чужие данные не видны
SECOND_DEMO_EMAIL=second@example.test
SECOND_DEMO_PASSWORD=
# Представитель допущенной организации (шахматный клуб «Ладья»)
ORG_DEMO_EMAIL=org@example.test
ORG_DEMO_PASSWORD=
# Представитель организации, ожидающей допуска (клуб скандинавской ходьбы «Сосны»)
ORG_PENDING_DEMO_EMAIL=org-pending@example.test
ORG_PENDING_DEMO_PASSWORD=
# Представитель отклонённой организации (студия «Пульс») — экран отказа с причиной
ORG_REJECTED_DEMO_EMAIL=org-rejected@example.test
ORG_REJECTED_DEMO_PASSWORD=
# Администратор (роли user и admin): админка, отчёты, журнал действий
ADMIN_DEMO_EMAIL=admin@example.test
ADMIN_DEMO_PASSWORD=


# -----------------------------------------------------------------------------
#  Связь gateway с сервисами
# -----------------------------------------------------------------------------
# Адреса сервисов для gateway, запущенного вне Docker (make gateway).
# Порт каждого сервиса задан в Makefile (make tasks → :8081 и т.д.).
TASKS_URL=http://localhost:8081
FILES_URL=http://localhost:8082
LLM_SERVICE_URL=http://localhost:8083
NOTIFICATIONS_URL=http://localhost:8084
AUDIT_URL=http://localhost:8085
REALTIME_URL=http://localhost:8086
# Сервис мероприятий (make events).
EVENTS_URL=http://localhost:8087

# Общий секрет gateway и сервисов: сервисы принимают запросы только с ним,
# поэтому обойти проверку входа, обратившись к сервису напрямую, нельзя.
# Сгенерируется автоматически. Если утёк — удалите значение и запустите make setup.
INTERNAL_TOKEN=


# -----------------------------------------------------------------------------
#  Локальная нейросеть (Ollama + Qwen)
# -----------------------------------------------------------------------------
# Модель скачивается отдельно: make llm (несколько ГБ, один раз).
# Без неё всё работает: ИИ-проверка идёт по правилам, ассистент сообщает,
# что модель недоступна.

# Адрес Ollama для сервиса llm, запущенного вне Docker.
LLM_URL=http://localhost:11434
# Какая модель используется. qwen2.5:1.5b — лёгкая, свободная лицензия Apache 2.0.
# Лучше качество — qwen2.5:7b (тоже Apache 2.0, но медленнее на CPU).
# Не берите qwen2.5:3b: у неё несвободная лицензия.
LLM_MODEL=qwen2.5:1.5b


# -----------------------------------------------------------------------------
#  Метрики Prometheus (http://localhost:8080/metrics)
# -----------------------------------------------------------------------------
# true — gateway отдаёт метрики (число запросов, время ответа).
METRICS_ENABLED=true
# Пусто — метрики открыты без пароля (нормально для локальной работы).
# В production обязательно задайте токен: запрос с заголовком
# Authorization: Bearer <токен>.
METRICS_TOKEN=


# -----------------------------------------------------------------------------
#  Тестовая почта Mailpit (http://localhost:8025)
# -----------------------------------------------------------------------------
# Сюда приходят все письма: подтверждение регистрации, сброс пароля, уведомления.
# Локально открыт без пароля. На сервере (compose.prod.yaml) доступен по
# https://ваш-домен/mail только с этим логином и паролем — их можно дать жюри,
# чтобы оно подтвердило почту при регистрации. Пароль сгенерирует make setup.
MAILPIT_USER=jury
MAILPIT_PASSWORD=


# -----------------------------------------------------------------------------
#  Уведомления в мессенджер MAX (необязательно)
# -----------------------------------------------------------------------------
# Без токена канал выключен, кнопка «Получать уведомления в MAX» не показывается.
# Токен выдают на платформе MAX для партнёров после проверки организации/ИП
# и модерации бота — получайте заранее, это не быстро.
# Проверить токен: curl -H "Authorization: <токен>" https://platform-api2.max.ru/me

# Токен бота (секрет — никому не пересылайте).
MAX_BOT_TOKEN=
# Имя бота (username из ответа /me) — для ссылки привязки max.ru/<имя>?start=...
MAX_BOT_USERNAME=
